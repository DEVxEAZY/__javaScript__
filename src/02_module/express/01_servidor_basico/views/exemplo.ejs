<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= titulo %></title>
</head>
<body>
    <h1><%= titulo %></h1>
    <p>Olá, <strong><%= nome %></strong>.</p>
    <p>Esta página foi renderizada com <code>res.render()</code> e o motor <strong>EJS</strong>.</p>
    <ul>
        <% itens.forEach(function (item) { %>
            <li><%= item %></li>
        <% }); %>
    </ul>
    <p><a href="/">Voltar à home</a></p>
</body>
</html>
