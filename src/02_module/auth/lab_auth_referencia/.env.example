# Copie para .env e preencha os valores.
# cp .env.example .env

# Postgres — obrigatorio para rodar este lab.
# Free tier: Supabase (Settings > Database > Connection string URI)
# ou Neon (Dashboard > Connection details > pooled connection).
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require

# Segredo da sessao — em producao use string longa e aleatoria (openssl rand -hex 32).
SESSION_SECRET=troque-isso-por-um-segredo-longo-em-producao

# Opcional — padrao 3000
PORTA=3000

# Opcional — "production" liga cookie.secure e comentarios sobre helmet
NODE_ENV=development
